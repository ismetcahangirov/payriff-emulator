{
  "name": "payriff-emulator",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial local emulator of the Payriff Gateway API v3 for integration tests and development",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "decimal.js": "^10.6.0",
    "fastify": "^5.6.1",
    "lossless-json": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ismetcahangirov/payriff-emulator.git"
  }
}
